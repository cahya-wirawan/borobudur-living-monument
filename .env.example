# No variable is required. There are no secrets in this project.

# Optional: turns on the "Fly over the real site" flight drawn by Google Maps.
# This is a browser key and is visible to every visitor, so restrict it in the
# Google Cloud console to this site's HTTP referrers and to the Maps JavaScript
# API. It needs a Google Cloud project with billing enabled. Read at build time.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base URL used for canonical and language-alternate links.
# NEXT_PUBLIC_SITE_URL=https://example.org

# Set to "public" only for a reviewed public release. It allows search
# indexing and makes the build fail while any content is unreviewed.
# RELEASE_CHANNEL=public
