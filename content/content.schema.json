{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/borobudur-content-v1.json",
  "title": "BOROBUDUR — Living Monument Content Pack",
  "description": "Starter structure; cross-reference validation and historical editorial review must be done separately. $id is intentionally a non-routable placeholder. v1.1.0 adds the optional `features` collection (architectural annotations); 1.0.0 packs are migrated by src/content/migrate.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "monument",
    "prototypeNotice",
    "sources",
    "claims",
    "chapters",
    "eras",
    "realms",
    "reliefs",
    "media"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "monument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "location",
        "illustrativeGeometry"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "location": {
          "$ref": "#/$defs/localized"
        },
        "illustrativeGeometry": {
          "type": "boolean"
        }
      }
    },
    "prototypeNotice": {
      "$ref": "#/$defs/localized"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "eras": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/era"
      }
    },
    "realms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/realm"
      }
    },
    "reliefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relief"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "id"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessedAt",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "enum": [
            "official",
            "scholarly",
            "archival",
            "other"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "evidenceStatus",
        "reviewStatus",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/localized"
        },
        "evidenceStatus": {
          "enum": [
            "documented",
            "inferred",
            "artistic"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "needs-review",
            "reviewed"
          ]
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "qualification": {
          "$ref": "#/$defs/localized"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidenceStatus": {
                "enum": [
                  "documented",
                  "inferred"
                ]
              }
            },
            "required": [
              "evidenceStatus"
            ]
          },
          "then": {
            "properties": {
              "sourceIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "claimIds"
      ],
      "properties": {
        "id": {
          "enum": [
            "awakening",
            "centuries",
            "architecture",
            "stories",
            "ascent"
          ]
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "summary": {
          "$ref": "#/$defs/localized"
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "provenance",
        "claimIds"
      ],
      "properties": {
        "id": {
          "enum": [
            "construction",
            "nineteenth-century",
            "restoration",
            "present"
          ]
        },
        "label": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "provenance": {
          "enum": [
            "documented",
            "inferred",
            "artistic"
          ]
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "realm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "explanation",
        "claimIds"
      ],
      "properties": {
        "id": {
          "enum": [
            "kamadhatu",
            "rupadhatu",
            "arupadhatu"
          ]
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "explanation": {
          "$ref": "#/$defs/localized"
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "relief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "demonstration",
        "claimIds",
        "mediaIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "demonstration": {
          "type": "boolean"
        },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "mediaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "verifiedLocation": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "alt",
        "kind",
        "provenance",
        "creator",
        "licenseId",
        "rightsReviewed",
        "attribution",
        "isOriginal"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "$ref": "#/$defs/localized"
        },
        "kind": {
          "enum": [
            "image",
            "model",
            "audio",
            "video",
            "illustration"
          ]
        },
        "provenance": {
          "enum": [
            "documented",
            "inferred",
            "artistic"
          ]
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "licenseId": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "rightsReviewed": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "isOriginal": {
          "type": "boolean"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "claimIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}